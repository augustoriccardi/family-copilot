# Application URL (required for OAuth redirects in production)
# Development: defaults to http://localhost:3000 if not set
# Production: REQUIRED - set to your public URL (e.g., https://myapp.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/agent
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
DATABASE_URL=postgresql://user:password@localhost:5434/mydb?schema=public
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# S3-Compatible Object Storage Configuration
# Development: MinIO (local Docker)
# Production: AWS S3, Cloudflare R2, or other S3-compatible service
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true  # Required for MinIO, false for AWS S3

# For production with AWS S3, update to:
# S3_ENDPOINT=  # Leave empty for AWS S3
# S3_ACCESS_KEY_ID=your_aws_access_key
# S3_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_FORCE_PATH_STYLE=false

# ─── Google Calendar MCP Integration ─────────────────────────────────────────
# Step 1: Create OAuth2 credentials at https://console.cloud.google.com
#         (Enable "Google Calendar API" + "Gmail API" + create a "Web application" OAuth client)
# Step 2: Add these Authorized redirect URIs to the OAuth client:
#           http://localhost:3000/api/google/callback   (development)
#           https://your-domain.com/api/google/callback  (production)
# Step 3: Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET below
# Step 4: Run:  node scripts/get-google-token.mjs  to get a global refresh token
#         (used as fallback when a member hasn't connected their own Google account)
# Step 5: Run:  node scripts/register-google-calendar.mjs  to register in DB
# Per-member Google accounts: each adult can connect via Settings → "Conectar Google"
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_CALENDAR_ID=primary  # or a specific calendar ID

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Setup guide: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
#
# Step 1: Create a Meta developer app at https://developers.facebook.com
# Step 2: Add the "WhatsApp" product to your app
# Step 3: Set up a WhatsApp Business Account and get a test phone number
# Step 4: Generate a permanent access token (System User token recommended)
# Step 5: Configure the webhook URL:
#           https://<your-domain>/api/whatsapp/webhook
#         with the verify token you set below
# Step 6: Subscribe to the "messages" webhook field
#
# Local testing: use ngrok to expose localhost
#   npx ngrok http 3000  → use the https URL as your webhook
#
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id          # From Meta app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token    # Permanent token (never expires)
WHATSAPP_VERIFY_TOKEN=your_random_verify_token         # Any secret string you choose
WHATSAPP_APP_SECRET=your_app_secret                    # App Settings → Basic → App Secret (for signature verification)


RESEND_API_KEY=re_abc123...     # la key que copiás del dashboard de Resend
EMAIL_FROM_ADDRESS=onboarding@resend.dev  # la default de Resend, sin verificar dominio
